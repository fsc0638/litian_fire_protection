# 放在主機 /opt/litian/.env，權限 600。這個範本本身不含任何真實金鑰。
# 下面兩個內部密碼由 02_up.sh 第一次執行時自動產生（openssl rand），不需手填，也不會印出來。
POSTGRES_PASSWORD=
MEILI_MASTER_KEY=

# 對外網址（見 Caddyfile 說明）。例：litian.<主機IP以連字號>.sslip.io
SITE_ADDRESS=
# 選填：同一個 Caddy 上已有其他網站時填其網址，04／05 腳本會比對它變更前後的狀態
CHECK_SITE=

# ---- 以下由你本人登入主機後填入，AI 不經手 ----
OPENAI_API_KEY=
# 填了 OPENAI_API_KEY 就會啟用 AI 回答（模型 gpt-5.6-sol）。
# 選填：法規問答的存取碼（英數字至少 12 個）。空白＝不要求存取碼，任何人都能用 AI 回答，只受每日上限控管
ASK_ACCESS_CODE=
# 每天 AI 問答的總次數上限（控管費用；台北時間每天 23:59 重新計算）
ASK_DAILY_LIMIT=500
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 審核工作台的 LINE 登入：LINE Developers 另建「LINE Login」頻道（和上面的機器人頻道不同）
# Channel ID、Channel secret 在頻道的 Basic settings；Callback URL 要和頻道 LINE Login 分頁登記的完全一樣
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# 例：https://<對外網址>/api/auth/line/callback
LINE_LOGIN_CALLBACK_URL=
